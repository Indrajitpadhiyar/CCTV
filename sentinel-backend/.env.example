APP_NAME=Sentinel AI CCTV Platform
ENVIRONMENT=development
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000

# Database Options (Neon / Supabase / Local Postgres)
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-super-boat-aeh9ii1j-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_SYNC=postgresql://neondb_owner:password@ep-super-boat-aeh9ii1j-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Endpoints:
NEON_API_URL=https://ep-super-boat-aeh9ii1j.apirest.c-2.us-east-2.aws.neon.tech/neondb/rest/v1
NEON_AUTH_URL=https://ep-super-boat-aeh9ii1j.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://ep-super-boat-aeh9ii1j.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Redis Cloud / Redis Enterprise Connection Example
REDIS_URL=redis://default:password@redis-15503.c9.us-east-1-2.ec2.cloud.redislabs.com:15503/0
CELERY_BROKER_URL=redis://default:password@redis-15503.c9.us-east-1-2.ec2.cloud.redislabs.com:15503/1
CELERY_RESULT_BACKEND=redis://default:password@redis-15503.c9.us-east-1-2.ec2.cloud.redislabs.com:15503/2

# CCTV Stream Endpoint Settings
CCTV_CATALOG_URL=https://cctv.corp8.cloud/cameras.json
CCTV_HLS_BASE_URL=https://cctv.corp8.cloud
CCTV_RTSP_HOST=103.250.160.189
CCTV_RTSP_PORT=8554
CCTV_STREAM_USER=your_email@example.com
CCTV_STREAM_PASSWORD=your_password

JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

LOG_LEVEL=INFO

AI_MODE=mock
AI_DEVICE=cpu
YOLO_MODEL_PATH=models/yolo.pt
OCR_ENABLED=true
ANPR_ENABLED=true
TRACKING_ENABLED=true

VIDEO_FRAME_SAMPLE_RATE=5
VIDEO_MAX_RECONNECT_ATTEMPTS=10

STORAGE_TYPE=local
STORAGE_PATH=./storage

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS
MINIO_SECRET_KEY=CHANGE_ME_SECRET
MINIO_BUCKET=evidence

DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

WEBSOCKET_ENABLED=true
