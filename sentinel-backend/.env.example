APP_NAME=Sentinel AI CCTV Platform
ENVIRONMENT=development
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000

# Database Options (Local Postgres or Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_password@postgres:5432/sentinel
DATABASE_URL_SYNC=postgresql://sentinel:sentinel_password@postgres:5432/sentinel

# Supabase PostgreSQL Integration Example:
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_KEY=your_supabase_anon_or_service_key
# DATABASE_URL=postgresql+asyncpg://postgres:<your-password>@db.<your-project-ref>.supabase.co:5432/postgres

REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CCTV Stream Endpoint Settings
CCTV_CATALOG_URL=https://cctv.corp8.cloud/cameras.json
CCTV_HLS_BASE_URL=https://cctv.corp8.cloud
CCTV_RTSP_HOST=103.250.160.189
CCTV_RTSP_PORT=8554
CCTV_STREAM_USER=your_email@example.com
CCTV_STREAM_PASSWORD=your_password

JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

LOG_LEVEL=INFO

AI_MODE=mock
AI_DEVICE=cpu
YOLO_MODEL_PATH=models/yolo.pt
OCR_ENABLED=true
ANPR_ENABLED=true
TRACKING_ENABLED=true

VIDEO_FRAME_SAMPLE_RATE=5
VIDEO_MAX_RECONNECT_ATTEMPTS=10

STORAGE_TYPE=local
STORAGE_PATH=./storage

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS
MINIO_SECRET_KEY=CHANGE_ME_SECRET
MINIO_BUCKET=evidence

DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

WEBSOCKET_ENABLED=true
